# Copy this file to .env and adjust the values for your computer.
# The postgres:postgres credentials are local development defaults created by
# scripts/setup_database.sql. Never reuse them in production or commit .env.

# Storage backend: "database" (PostgreSQL, the default) or "memory"
# (process-local data that is lost when the API stops).
STORAGE_BACKEND=database

# Required when STORAGE_BACKEND=database.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/library_management

# Set to true to print the SQL that SQLAlchemy sends to PostgreSQL.
DATABASE_ECHO_SQL=false
